PORT=3100
CONTENT_ROOT=/home/sio/Code/Interview
DB_PATH=./data/interview.db

# --- LLM Provider API Keys ---
# Direct API keys — when ANY of these are set, OAuth (below) is NOT required.
OPENAI_API_KEY=
OPENAI_BASE_URL=
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=
GOOGLE_API_KEY=
GOOGLE_BASE_URL=

# --- OAuth (fallback for OpenAI-compatible models) ---
# Only required when using OpenAI-compatible models WITHOUT OPENAI_API_KEY set.
# When any direct API key above is configured, these can be left empty.
OAUTH_CLIENT_ID=
OAUTH_CLIENT_SECRET=
OAUTH_TOKEN_URL=

DEBUG_RUNS=false
